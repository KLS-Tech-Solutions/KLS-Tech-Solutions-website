# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env — it contains a credential.

# --- SMTP (contact form delivery) ---------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=klstechsolutions2025@gmail.com

# Gmail requires an App Password here, not the account password.
# Generate one at https://myaccount.google.com/apppasswords
# (2-Step Verification must be enabled on the account first.)
SMTP_PASSWORD=

# Where contact form submissions are delivered.
RECIPIENT_EMAIL=klstechsolutions2025@gmail.com
